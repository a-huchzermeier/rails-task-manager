<div class = "container">
  <%= form_with model: @task do |f| %>
    <p> <%= f.label :title %>
    <%= f.text_field :title %> </p>

    <p><%= f.label :details %>
    <%= f.text_field :details %></p>

    <p><%= f.check_box :completed %>
    <%= f.label :completed, "Completed" %></p>

    <%= f.submit %>
  <% end %>
</div>
